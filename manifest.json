{
  "manifest_version": 3,
  "name": "ChromeSync",
  "version": "0.2.0",
  "description": "Optional ChromeSync companion: send cookies from this Chrome profile to your other browsers.",
  "permissions": [
    "cookies",
    "alarms",
    "storage",
    "nativeMessaging",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ChromeSync"
  },
  "key": "",
  "minimum_chrome_version": "130"
}
