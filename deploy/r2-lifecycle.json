{
  "rules": [
    {
      "id": "chromesync-expire-snapshots",
      "enabled": true,
      "conditions": { "prefix": "rooms/" },
      "deleteObjectsTransition": { "condition": { "type": "Age", "maxAge": 604800 } }
    },
    {
      "id": "chromesync-abort-incomplete-uploads",
      "enabled": true,
      "conditions": { "prefix": "" },
      "abortMultipartUploadsTransition": { "condition": { "type": "Age", "maxAge": 86400 } }
    }
  ]
}
